        "outputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "providerAttempts": {
          "type": "integer",
          "minimum": 0
        },
        "repairAttempted": {
          "type": "boolean"
        },
        "validationStatus": {
          "type": "string",
          "minLength": 1
        },
        "workerVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider",
        "model",
        "promptId",
        "promptVersion",
        "promptSha256",
        "providerRequestId",
        "latencyMs",
        "inputTokens",
        "outputTokens",
        "providerAttempts",
        "repairAttempted",
        "validationStatus",
        "workerVersion"
      ]
