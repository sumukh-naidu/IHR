{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ihr.internal/contracts/events/ihr.interview.followup.completed.v1.json",
  "title": "Payload of ihr.interview.followup.completed (A.5)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "jobId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "ASK_FOLLOW_UP",
            "NEXT_QUESTION"
          ]
        },
        "reasonCode": {
          "type": "string",
          "enum": [
            "CLARIFY_AMBIGUITY",
            "PROBE_DEPTH",
            "ANSWER_INCOMPLETE",
            "ANSWER_SUFFICIENT",
            "NOT_USEFUL"
          ]
        },
        "followUp": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1
                },
                "competencyCodes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              },
              "required": [
                "text",
                "competencyCodes"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "decision",
        "reasonCode",
        "followUp"
      ]
    },
    "outputSchemaVersion": {
      "const": "followup_decision.v1"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "promptId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "promptVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "promptSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "providerRequestId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "latencyMs": {
          "type": "integer",
          "minimum": 0
        },
        "inputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "outputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "providerAttempts": {
          "type": "integer",
          "minimum": 0
        },
        "repairAttempted": {
          "type": "boolean"
        },
        "validationStatus": {
          "type": "string",
          "minLength": 1
        },
        "workerVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider",
        "model",
        "promptId",
        "promptVersion",
        "promptSha256",
        "providerRequestId",
        "latencyMs",
        "inputTokens",
        "outputTokens",
        "providerAttempts",
        "repairAttempted",
        "validationStatus",
        "workerVersion"
      ]
    }
  },
  "required": [
    "jobId",
    "attempt",
    "output",
    "outputSchemaVersion",
    "run"
  ]
}
