{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ihr.internal/contracts/ai-schemas/followup_decision.v1.json",
  "title": "followup_decision.v1 (chapter 7)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "ASK_FOLLOW_UP",
        "NEXT_QUESTION"
      ]
    },
    "reasonCode": {
      "type": "string",
      "enum": [
        "CLARIFY_AMBIGUITY",
        "PROBE_DEPTH",
        "ANSWER_INCOMPLETE",
        "ANSWER_SUFFICIENT",
        "NOT_USEFUL"
      ]
    },
    "followUp": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "competencyCodes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "text",
            "competencyCodes"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "decision",
    "reasonCode",
    "followUp"
  ]
}
