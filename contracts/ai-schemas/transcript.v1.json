{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ihr.internal/contracts/ai-schemas/transcript.v1.json",
  "title": "transcript.v1 (chapter 7)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "transcript.v1"
    },
    "language": {
      "const": "en"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "speechDetected": {
      "type": "boolean"
    },
    "avgConfidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "qualityFlags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "NO_SPEECH",
          "LOW_CONFIDENCE",
          "POSSIBLE_HALLUCINATION",
          "CLIPPED_AUDIO",
          "TRUNCATED_AT_LIMIT"
        ]
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "startMs": {
            "type": "integer",
            "minimum": 0
          },
          "endMs": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "noSpeechProb": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "w": {
                  "type": "string"
                },
                "startMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "endMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "p": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "w",
                "startMs",
                "endMs",
                "p"
              ]
            }
          }
        },
        "required": [
          "index",
          "startMs",
          "endMs",
          "text",
          "confidence",
          "noSpeechProb",
          "words"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "language",
    "model",
    "durationMs",
    "speechDetected",
    "avgConfidence",
    "qualityFlags",
    "segments"
  ]
}
