              "NO_EMPLOYMENT_HISTORY",
              "NO_SKILLS_FOUND",
              "ENCRYPTED_DOCUMENT",
              "TEXT_GARBLED",
              "MULTIPLE_PEOPLE_DESCRIBED",
              "NOT_A_CV"
