                      "minLength": 8
                    }
                  },
                  "required": [
                    "quote"
                  ]
                },
                "minItems": 0,
                "maxItems": 3
              },
              "rationale": {
                "type": "string",
                "maxLength": 400
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH"
                ]
              }
            },
            "required": [
              "requirementCode",
