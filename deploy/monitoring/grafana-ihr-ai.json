{
 "title": "IHR AI services",
 "uid": "ihr-ai",
 "schemaVersion": 39,
 "tags": [
  "ihr",
  "ai"
 ],
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Jobs by task and outcome (per min)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (task, outcome) (rate(ihr_ai_jobs_total[5m])) * 60",
     "legendFormat": "{{task}} {{outcome}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Failure rate by task (AiFailureRate > 5 %)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (task) (rate(ihr_ai_jobs_total{outcome=\"failed\"}[30m])) / clamp_min(sum by (task) (rate(ihr_ai_jobs_total[30m])), 1e-9)",
     "legendFormat": "{{task}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Provider latency p95 by task (FOLLOWUP alert at 6 s)",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, task) (rate(ihr_ai_llm_latency_seconds_bucket[10m])))",
     "legendFormat": "{{task}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Validation outcome (repair rate alert 15 %)",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (task, result) (rate(ihr_ai_validation_total[1h]))",
     "legendFormat": "{{task}} {{result}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Policy rejections by task / rule",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (task, rule) (increase(ihr_ai_policy_rejections_total[1h]))",
     "legendFormat": "{{task}} {{rule}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Plan fallback questions",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (reason) (increase(ihr_ai_fallback_questions_total[1h]))",
     "legendFormat": "{{reason}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Injection flags (spike alert > 10/h)",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (task) (increase(ihr_ai_injection_flags_total[1h]))",
     "legendFormat": "{{task}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Tokens per day vs budget",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (task, direction) (increase(ihr_ai_tokens_total[1d]))",
     "legendFormat": "{{task}} {{direction}}"
    },
    {
     "refId": "B",
     "expr": "max(ihr_ai_token_budget_monthly) / 30",
     "legendFormat": "daily budget"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Circuit state (1 = open)",
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (provider) (ihr_provider_circuit_open)",
     "legendFormat": "{{provider}}"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "STT p95 job duration (alert 6 s) and real-time factor",
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(ihr_speech_job_duration_seconds_bucket{task=\"TRANSCRIPTION\"}[10m])))",
     "legendFormat": "p95 job s"
    },
    {
     "refId": "B",
     "expr": "sum(rate(ihr_stt_duration_seconds_sum[10m])) / clamp_min(sum(rate(ihr_stt_audio_seconds_sum[10m])), 1e-9)",
     "legendFormat": "RTF"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "STT quality flags",
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (flag) (increase(ihr_stt_quality_flags_total[1h]))",
     "legendFormat": "{{flag}}"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "TTS requests by provider / outcome, cache hits",
   "gridPos": {
    "x": 12,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (provider, outcome) (rate(ihr_tts_requests_total[10m])) * 60",
     "legendFormat": "{{provider}} {{outcome}}"
    },
    {
     "refId": "B",
     "expr": "rate(ihr_tts_cache_hits_total[10m]) * 60",
     "legendFormat": "cache hits"
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Redactions by type",
   "gridPos": {
    "x": 0,
    "y": 48,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (type) (increase(ihr_ai_redactions_total[1d]))",
     "legendFormat": "{{type}}"
    }
   ]
  }
 ]
}
